#!/usr/bin/env python3
"""
usbtype — Standalone CLI USB Keystroke Injector
==============================================
Usage:
  usbtype "Text to type directly into PC"
  usbtype -f script.ps1
  usbtype --delay 30 "Slow typing text"
  usbtype --key win+r
  usbtype --key enter
"""

import sys
import os
import time
import ssl
import argparse
import urllib.request
import json

INSTALL_DIR = os.environ.get("EMITTR_INSTALL_DIR", "/opt/usb_hid_deck")
TOKEN_FILE = os.path.join(INSTALL_DIR, ".emittr_token")
_CERT_DIR = os.path.join(INSTALL_DIR, "certs")
_HAS_TLS = os.path.exists(os.path.join(_CERT_DIR, "emittr.crt")) and os.path.exists(os.path.join(_CERT_DIR, "emittr.key"))
_PORT = os.environ.get("EMITTR_PORT", "8088")
SERVER_URL = os.environ.get("EMITTR_SERVER_URL", f"{'https' if _HAS_TLS else 'http'}://127.0.0.1:{_PORT}")
# Server uses a self-signed cert for this loopback call; verification isn't meaningful here.
_SSL_CTX = ssl._create_unverified_context() if SERVER_URL.startswith("https") else None


def _load_token():
    try:
        with open(TOKEN_FILE, "r", encoding="utf-8") as f:
            return f.read().strip()
    except Exception:
        return ""


AUTH_TOKEN = _load_token()


def send_via_api(endpoint, payload):
    try:
        data = json.dumps(payload).encode("utf-8")
        headers = {"Content-Type": "application/json"}
        if AUTH_TOKEN:
            headers["X-Emittr-Token"] = AUTH_TOKEN
        req = urllib.request.Request(
            f"{SERVER_URL}{endpoint}",
            data=data,
            headers=headers,
        )
        with urllib.request.urlopen(req, timeout=5, context=_SSL_CTX) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return {"ok": False, "error": str(e)}

def main():
    parser = argparse.ArgumentParser(description="Inject keystrokes over USB to connected PC")
    parser.add_argument("text", nargs="?", help="Text string to type")
    parser.add_argument("-f", "--file", help="Path to text or script file to type")
    parser.add_argument("-d", "--delay", type=int, default=15, help="Typing delay in ms per character (default 15)")
    parser.add_argument("-k", "--key", help="Special key or combo to inject (e.g. enter, win+r, ctrl+c)")
    parser.add_argument("--stop", action="store_true", help="Stop any active typing job")
    parser.add_argument("--status", action="store_true", help="Print USB connection status")

    args = parser.parse_args()

    if args.status:
        try:
            headers = {"X-Emittr-Token": AUTH_TOKEN} if AUTH_TOKEN else {}
            req = urllib.request.Request(f"{SERVER_URL}/api/status", headers=headers)
            with urllib.request.urlopen(req, timeout=3, context=_SSL_CTX) as resp:
                status = json.loads(resp.read().decode())
                print(f"USB Host Connected: {status.get('attached')}")
                print(f"UDC State:          {status.get('state')}")
                print(f"Speed:              {status.get('speed')}")
                print(f"Keyboard Node:      {status.get('hid_node_exists')}")
                print(f"HID Mode Enabled:   {status.get('hid_mode_enabled')}")
        except Exception as e:
            print(f"Error checking status: {e}")
        return

    if args.stop:
        res = send_via_api("/api/stop", {})
        print(res.get("msg", "Stopped"))
        return

    if args.key:
        res = send_via_api("/api/key", {"combo": args.key, "key": args.key})
        if res.get("ok"):
            print(f"[+] Key/combo '{args.key}' injected successfully")
        else:
            print(f"[-] Error: {res.get('msg', 'Unknown error')}")
        return

    text_to_type = ""
    if args.file:
        if not os.path.exists(args.file):
            print(f"[-] Error: File not found: {args.file}")
            sys.exit(1)
        with open(args.file, "r", encoding="utf-8", errors="ignore") as f:
            text_to_type = f.read()
    elif args.text:
        text_to_type = args.text

    if not text_to_type:
        parser.print_help()
        sys.exit(1)

    print(f"[*] Sending {len(text_to_type)} characters to PC (delay={args.delay}ms)...")
    res = send_via_api("/api/type", {"text": text_to_type, "delay_ms": args.delay})
    if res.get("ok"):
        print(f"[+] {res.get('msg', 'Job submitted')}")
    else:
        print(f"[-] Error: {res.get('msg', res.get('error', 'Failed'))}")

if __name__ == "__main__":
    main()
